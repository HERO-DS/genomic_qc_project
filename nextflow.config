docker {
    enabled = true
}

process {
    withName: FASTQC {
        container = 'biocontainers/fastqc:v0.11.9_cv8'
        cpus = 2
        memory = '2 GB'
    }
    withName: MULTIQC {
        container = 'multiqc/multiqc:v1.19'
        cpus = 1
        memory = '1 GB'
    }
}

// Generate execution metrics and visual flowcharts automatically
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}